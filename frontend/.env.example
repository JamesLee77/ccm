# Copy to .env and fill in.
# Required for wallet connect (used by /defi and /markets routes).
# https://cloud.walletconnect.com — project id
VITE_WALLETCONNECT_PROJECT_ID=demo-project-id

# Optional: override default Base RPC endpoints.
# VITE_BASE_RPC=https://mainnet.base.org
# VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
