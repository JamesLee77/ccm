.env
.env.*
!.env.example

# Cloudflare wrangler local state
.wrangler/

# Spurious root package-lock (no root package.json — this should be deleted, not committed)
/package-lock.json

# Sensitive / unreviewed design assets — left untracked for explicit operator decision
# (Korean legal agreement drafts, source design archive)
docs/design/ccm.zip
docs/design/design_handoff_ccm_network/

# Phase 2 Sepolia rehearsal — ephemeral test wallet keys (throwaway, Sepolia only)
.phase2-rehearsal-keys.json
.phase2-rehearsal-state.json
onchain/scripts/_phase2-*.ts

# Carbon oracle keeper wallet (Sepolia hot key for Worker — rotate periodically)
.carbon-oracle-keeper.json
onchain/scripts/_carbon-*.ts

# DEX seeding throwaway scripts (Sepolia Uniswap V3 setup)
onchain/scripts/_dex-*.ts
.dex-rehearsal-state.json

# Monthly audit log CSV exports — contain wallet addresses and operator
